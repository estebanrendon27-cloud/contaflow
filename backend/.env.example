# ═══════════════════════════════════════════
#  ContaFlow — Variables de entorno
#  Copia este archivo como .env y completa
# ═══════════════════════════════════════════

# SERVIDOR
PORT=3001
NODE_ENV=development
API_VERSION=v1

# BASE DE DATOS PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contaflow_db
DB_USER=contaflow_user
DB_PASSWORD=tu_password_seguro
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# JWT
JWT_SECRET=tu_jwt_secret_muy_largo_y_seguro_aqui_minimo_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=tu_refresh_secret_diferente_al_jwt_secret
JWT_REFRESH_EXPIRES_IN=30d

# CLAUDE API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# DIAN API
DIAN_API_URL=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc
DIAN_TEST_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
DIAN_NIT_TECNICO=tu_nit_tecnico
DIAN_PIN=tu_pin_tecnico

# ALMACENAMIENTO
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=xlsx,xls,csv,pdf,p12,pfx,cer

# SEGURIDAD
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# EMAIL (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@contaflow.co
SMTP_PASS=tu_app_password
FROM_EMAIL=ContaFlow <notificaciones@contaflow.co>

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.contaflow.co

# LOGS
LOG_LEVEL=info
LOG_FILE=./logs/contaflow.log
